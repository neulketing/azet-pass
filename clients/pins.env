# Upstream Bitwarden clients (GPL-3.0) that AZET Pass is built from. Latest stable and the one before (reference rule: open both).
CLIENTS_REPO=https://github.com/bitwarden/clients.git
BROWSER_TAG=browser-v2026.9.3
BROWSER_PREV_TAG=browser-v2026.9.2
# Browser extension version = upstream tag + AZET revision (stores need a higher version for each upload)
EXT_VERSION=${EXT_VERSION:-2026.9.3.4}
DESKTOP_TAG=desktop-v2026.9.1
DESKTOP_PREV_TAG=desktop-v2026.9.0
ANDROID_REPO=https://github.com/bitwarden/android.git
ANDROID_TAG=v2026.9.1-bwpm
IOS_REPO=https://github.com/bitwarden/ios.git
IOS_TAG=v2026.9.1-bwpm
